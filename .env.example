# Copy only on a NEW installation; never overwrite an existing private .env.
# Simulation, no external provider by default.
EXPLORER_MODE=disabled
EXPLORER_DEFAULT_MODE=disabled
ANALYSIS_DEFAULT_ENGINE=false
DEMO_ENABLED=true
DEMO_ALLOW_LIVE=false
GAME_ALLOW_TOOLS=false
STOCKFISH_ENABLED=false
STOCKFISH_PATH=/usr/games/stockfish
STOCKFISH_TIME_SECONDS=0.5
YOUTUBE_MODE=disabled
MONGO_ENABLED=false
ADVISOR_API_PROVIDER=mistral
ADVISOR_API_MODEL=mistral-small-latest
ADVISOR_API_ENDPOINT=https://api.mistral.ai/v1/chat/completions
ADVISOR_API_SECRET_ENV=MISTRAL_API_KEY
ADVISOR_API_TIMEOUT_SECONDS=15
MISTRAL_MAX_TOKENS=512
GROQ_MAX_TOKENS=2048
GROQ_REASONING_EFFORT=low
LOCAL_LLM_MAX_TOKENS=128
LOCAL_LLM_TIMEOUT_SECONDS=45
# Secret values are deliberately absent. Configure privately only when required:
# LICHESS_API_TOKEN=<private-value-not-in-git>
# MISTRAL_API_KEY=<private-value-not-in-git>
# GROQ_API_KEY=<private-value-not-in-git>
# YOUTUBE_API_KEY=<private-value-not-in-git>
# MONGO_PASSWORD=<64-random-lowercase-hex-characters>
# MONGO_ADMIN_PASSWORD=<different-64-random-lowercase-hex-characters>
# Optional operator-owned GGUF directory and basename (no download at startup):
# LOCAL_LLM_MODEL_DIR=/absolute/operator-owned/gguf
# LOCAL_LLM_MODEL_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
# LOCAL_LLM_CONTEXT=2048
# LOCAL_LLM_THREADS=2
