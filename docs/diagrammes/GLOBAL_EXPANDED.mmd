---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	route_action(route_action)
	finish_action(finish_action)
	__end__([<p>__end__</p>]):::last
	__start__ --> route_action;
	analysis\3acheck_result --> finish_action;
	rag\3acheck_result --> finish_action;
	route_action -.-> analysis\3aadmit_action;
	route_action -.-> rag\3aadmit_action;
	route_action -.-> sessions\3aadmit_action;
	route_action -.-> videos\3aadmit_action;
	sessions\3acheck_result --> finish_action;
	videos\3acheck_result --> finish_action;
	finish_action --> __end__;
	subgraph analysis
	analysis\3aadmit_action(admit_action)
	analysis\3aexecute_action(execute_action)
	analysis\3acheck_result(check_result)
	analysis\3aadmit_action --> analysis\3aexecute_action;
	analysis\3aexecute_action --> analysis\3acheck_result;
	end
	subgraph rag
	rag\3aadmit_action(admit_action)
	rag\3aexecute_action(execute_action)
	rag\3acheck_result(check_result)
	rag\3aadmit_action --> rag\3aexecute_action;
	rag\3aexecute_action --> rag\3acheck_result;
	end
	subgraph videos
	videos\3aadmit_action(admit_action)
	videos\3aexecute_action(execute_action)
	videos\3acheck_result(check_result)
	videos\3aadmit_action --> videos\3aexecute_action;
	videos\3aexecute_action --> videos\3acheck_result;
	end
	subgraph sessions
	sessions\3aadmit_action(admit_action)
	sessions\3aexecute_action(execute_action)
	sessions\3acheck_result(check_result)
	sessions\3aadmit_action --> sessions\3aexecute_action;
	sessions\3aexecute_action --> sessions\3acheck_result;
	end
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
